// raytrace.comp — 路径追踪(Path Tracing) compute shader
// BVH栈遍历 + NEE(下一事件估计) + 蒙特卡洛积分 + 俄罗斯轮盘赌
// 多bounce迭代式路径追踪 + 帧累积降噪，输出到storage image (rgba8)
//
// Push constant布局 (40 bytes, std430):
//   offset 0:  camera_pos (vec3, 12 bytes)
//   offset 12: camera_yaw (float, 4 bytes)
//   offset 16: camera_pitch (float, 4 bytes)
//   offset 20: emissive_count (float, 4 bytes) — 原_pad1改为emissive三角形数量
//   offset 24: viewport_size (vec2, 8 bytes)
//   offset 32: fov (float, 4 bytes)
//   offset 36: frame_index (float, 4 bytes) — 帧累积索引，相机移动时重置为0
//   总计: 40 bytes
//
// Descriptor bindings:
//   set=0, binding=0: SSBO BvhNode[] (std430, 32 bytes each)
//   set=0, binding=1: SSBO vec4[] vertices (position.xyz + pad)
//   set=0, binding=2: SSBO uint[] indices
//   set=0, binding=3: SSBO vec4[] light_data (2 vec4s: dir+pad, color+intensity)
//   set=0, binding=4: SSBO vec4[] colors (per-vertex RGBA, alpha>1.5=emissive)
//   set=0, binding=5: SSBO EmissiveTriangle[] (std430, 80 bytes each)
//   set=2, binding=0: storage image rgba8 (output)
//   set=2, binding=1: storage image rgba32f (accumulation buffer)

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// === Push constants (40 bytes, std430) ===
layout(push_constant) uniform PushConstants {
    vec3 camera_pos;      // offset 0, 12 bytes
    float camera_yaw;     // offset 12, 4 bytes
    float camera_pitch;   // offset 16, 4 bytes
    float emissive_count; // offset 20, 4 bytes — emissive三角形数量
    vec2 viewport_size;   // offset 24, 8 bytes
    float fov;            // offset 32, 4 bytes
    float frame_index;    // offset 36, 4 bytes — 帧累积索引
} pc;

// === BvhNode (32 bytes, std430) ===
struct BvhNode {
    vec3 boundsMin;   // offset 0, 12 bytes
    uint leftChild;   // offset 12, 4 bytes — LEAF_MARKER=0xFFFFFFFF表示叶子节点
    vec3 boundsMax;   // offset 16, 12 bytes
    uint rightChild;  // offset 28, 4 bytes — 叶子节点时存储三角形起始索引
};

// === EmissiveTriangle (80 bytes, std430, vec4对齐) ===
struct EmissiveTriangle {
    vec4 v0_area;      // v0.xyz + triangle_area (offset 0, 16 bytes)
    vec4 v1_pad;       // v1.xyz + 0(pad) (offset 16, 16 bytes)
    vec4 v2_pad;       // v2.xyz + 0(pad) (offset 32, 16 bytes)
    vec4 normal_pad;   // normal.xyz + 0(pad) (offset 48, 16 bytes)
    vec4 color_int;    // color.xyz + intensity (offset 64, 16 bytes)
};

// === Descriptor set 0: 场景数据 ===
layout(std430, set = 0, binding = 0) readonly buffer BvhNodes {
    BvhNode nodes[];
} bvh;

layout(std430, set = 0, binding = 1) readonly buffer Vertices {
    vec4 verts[];      // position.xyz + pad
} vertex_buf;

layout(std430, set = 0, binding = 2) readonly buffer Indices {
    uint indices[];
} index_buf;

layout(std430, set = 0, binding = 3) readonly buffer LightData {
    vec4 light_entries[];  // [0]: dir.xyz + pad, [1]: color.xyz + intensity
} light_buf;

layout(std430, set = 0, binding = 4) readonly buffer Colors {
    vec4 colors[];  // per-vertex RGBA, alpha>1.5=emissive
} color_buf;

layout(std430, set = 0, binding = 5) readonly buffer EmissiveTriangles {
    EmissiveTriangle emissive_tris[];
} emissive_buf;

// === Descriptor set 2: 输出图像 + 累积缓冲区 ===
layout(set = 2, binding = 0, rgba8) writeonly uniform image2D output_image;
layout(set = 2, binding = 1, rgba32f) uniform image2D accumulation_image;

// === 常量 ===
const uint LEAF_MARKER = 0xFFFFFFFFu;
const uint BVH_STACK_SIZE = 32;
const float EPSILON = 1e-6;
const float INF = 1e30;
const int MAX_BOUNCES = 4;
const int N_LIGHT_SAMPLES = 4;

// === ray-AABB intersection (slab method) ===
bool intersect_aabb(vec3 ray_origin, vec3 ray_dir, vec3 bounds_min, vec3 bounds_max) {
    float t_min = 0.0;
    float t_max = INF;

    for (int i = 0; i < 3; i++) {
        if (abs(ray_dir[i]) < EPSILON) {
            // ray平行于此轴 — 如果origin不在slab内则无交点
            if (ray_origin[i] < bounds_min[i] || ray_origin[i] > bounds_max[i]) {
                return false;
            }
        } else {
            float inv_d = 1.0 / ray_dir[i];
            float t1 = (bounds_min[i] - ray_origin[i]) * inv_d;
            float t2 = (bounds_max[i] - ray_origin[i]) * inv_d;
            if (inv_d < 0.0) {
                // ray方向为负，交换t1/t2
                float tmp = t1;
                t1 = t2;
                t2 = tmp;
            }
            t_min = max(t_min, t1);
            t_max = min(t_max, t2);
            if (t_min > t_max) return false;
        }
    }
    return t_max >= 0.0;
}

// === Hit信息结构体 ===
struct HitInfo {
    float t;       // 交点距离
    float u, v;    // barycentric坐标
};

HitInfo intersect_triangle_bary(vec3 ray_origin, vec3 ray_dir,
                                  vec3 v0, vec3 v1, vec3 v2) {
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(ray_dir, edge2);
    float a = dot(edge1, h);

    // ray平行于三角形平面
    if (abs(a) < EPSILON) return HitInfo(-1.0, 0.0, 0.0);

    float f = 1.0 / a;
    vec3 s = ray_origin - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return HitInfo(-1.0, 0.0, 0.0);

    vec3 q = cross(s, edge1);
    float v = f * dot(ray_dir, q);
    if (v < 0.0 || u + v > 1.0) return HitInfo(-1.0, 0.0, 0.0);

    float t = f * dot(edge2, q);
    if (t > EPSILON) return HitInfo(t, u, v);

    return HitInfo(-1.0, 0.0, 0.0);
}

// === 伪随机数生成 (PCG hash) ===
uint pcg_hash(uint seed_in) {
    uint state = seed_in * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float random_float(uint seed) {
    return float(pcg_hash(seed)) / 4294967295.0;
}

// === Cosine-weighted半球采样 ===
// 在normal方向的半球内生成随机方向，cosine权重使靠近normal的方向概率更高
vec3 cosine_hemisphere_sample(vec3 normal, uint seed) {
    float r1 = random_float(seed);
    float r2 = random_float(pcg_hash(seed));

    float phi = 2.0 * 3.14159265 * r1;
    float cos_theta = sqrt(r2);
    float sin_theta = sqrt(1.0 - r2);

    // 局部半球坐标
    vec3 local_dir = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);

    // 从normal构建tangent frame
    vec3 up = abs(normal.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * local_dir.x + bitangent * local_dir.y + normal * local_dir.z);
}

// === luminance函数 — 用于俄罗斯轮盘赌概率计算 ===
float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

// === 三角形表面随机采样 — 用barycentric坐标 ===
// 在三角形表面均匀随机采样一个点
vec3 sample_point_on_triangle(vec3 v0, vec3 v1, vec3 v2, uint seed) {
    float u = random_float(seed);
    float v = random_float(pcg_hash(seed));
    // 折叠到三角形内: 如果u+v>1，映射到(1-u, 1-v)
    if (u + v > 1.0) {
        u = 1.0 - u;
        v = 1.0 - v;
    }
    return (1.0 - u - v) * v0 + u * v1 + v * v2;
}

// === BVH光线追踪 — 返回最近命中信息 ===
// 包含命中点属性: albedo, normal, emissive标志, 命中距离
struct PathHit {
    vec3 albedo;       // 命中表面颜色(barycentric插值)
    vec3 normal;       // 命中表面法线(面法线，朝向射线来源)
    float emissive;    // emissive标志(alpha>1.5)
    float distance;    // 命中距离
    bool hit;          // 是否命中
};

PathHit trace_path_ray(vec3 origin, vec3 direction) {
    uint t_stack[BVH_STACK_SIZE];
    int t_sp = 0;
    t_stack[t_sp] = 0u;

    float closest_t = INF;
    uint closest_i0 = 0u;
    uint closest_i1 = 0u;
    uint closest_i2 = 0u;
    float closest_u = 0.0;
    float closest_v = 0.0;
    bool found = false;

    while (t_sp >= 0) {
        uint node_idx = t_stack[t_sp];
        t_sp--;

        BvhNode node = bvh.nodes[node_idx];
        if (!intersect_aabb(origin, direction, node.boundsMin, node.boundsMax)) continue;

        if (node.leftChild == LEAF_MARKER) {
            uint tri_start = node.rightChild;
            uint i0 = index_buf.indices[tri_start + 0u];
            uint i1 = index_buf.indices[tri_start + 1u];
            uint i2 = index_buf.indices[tri_start + 2u];

            vec3 v0 = vertex_buf.verts[i0].xyz;
            vec3 v1 = vertex_buf.verts[i1].xyz;
            vec3 v2 = vertex_buf.verts[i2].xyz;

            HitInfo hit_info = intersect_triangle_bary(origin, direction, v0, v1, v2);
            float t = hit_info.t;
            if (t > EPSILON && t < closest_t) {
                closest_t = t;
                found = true;
                closest_i0 = i0;
                closest_i1 = i1;
                closest_i2 = i2;
                closest_u = hit_info.u;
                closest_v = hit_info.v;
            }
        } else {
            t_sp++;
            if (t_sp >= BVH_STACK_SIZE) break;
            t_stack[t_sp] = node.rightChild;
            t_sp++;
            if (t_sp >= BVH_STACK_SIZE) break;
            t_stack[t_sp] = node.leftChild;
        }
    }

    PathHit result;
    result.hit = found;
    result.distance = closest_t;

    if (found) {
        vec4 c0 = color_buf.colors[closest_i0];
        vec4 c1 = color_buf.colors[closest_i1];
        vec4 c2 = color_buf.colors[closest_i2];
        result.albedo = (1.0 - closest_u - closest_v) * c0.xyz + closest_u * c1.xyz + closest_v * c2.xyz;
        result.emissive = (1.0 - closest_u - closest_v) * c0.w + closest_u * c1.w + closest_v * c2.w;
        // 计算命中三角形面法线: cross(v1-v0, v2-v0)
        vec3 v0 = vertex_buf.verts[closest_i0].xyz;
        vec3 v1 = vertex_buf.verts[closest_i1].xyz;
        vec3 v2 = vertex_buf.verts[closest_i2].xyz;
        vec3 face_normal = normalize(cross(v1 - v0, v2 - v0));
        // 确保法线朝向射线来源方向（与ray_dir反向）
        if (dot(face_normal, direction) > 0.0) {
            face_normal = -face_normal;
        }
        result.normal = face_normal;
    } else {
        result.albedo = vec3(0.0);
        result.normal = vec3(0.0);
        result.emissive = 0.0;
    }

    return result;
}

// === 阴影射线测试 — 检查从hit_point到target_point之间是否有遮挡 ===
// 返回true表示被遮挡（非emissive表面阻挡光线）
bool shadow_test(vec3 hit_point, vec3 hit_normal, vec3 target_point, float target_dist) {
    vec3 shadow_dir = normalize(target_point - hit_point);
    vec3 shadow_origin = hit_point + hit_normal * EPSILON * 2.0;

    uint shadow_stack[BVH_STACK_SIZE];
    int shadow_sp = 0;
    shadow_stack[shadow_sp] = 0u;

    while (shadow_sp >= 0) {
        uint snode_idx = shadow_stack[shadow_sp];
        shadow_sp--;
        BvhNode snode = bvh.nodes[snode_idx];
        if (!intersect_aabb(shadow_origin, shadow_dir, snode.boundsMin, snode.boundsMax)) continue;
        if (snode.leftChild == LEAF_MARKER) {
            uint si0 = index_buf.indices[snode.rightChild + 0u];
            uint si1 = index_buf.indices[snode.rightChild + 1u];
            uint si2 = index_buf.indices[snode.rightChild + 2u];
            float st = intersect_triangle_bary(shadow_origin, shadow_dir,
                vertex_buf.verts[si0].xyz, vertex_buf.verts[si1].xyz, vertex_buf.verts[si2].xyz).t;
            if (st > EPSILON && st < target_dist) {
                // emissive表面(alpha>1.5)不遮挡光线 — 光源自身透明
                float shadow_alpha = color_buf.colors[si0].w;
                if (shadow_alpha <= 1.5) {
                    return true; // 被非emissive表面遮挡
                }
            }
        } else {
            shadow_sp++;
            if (shadow_sp >= BVH_STACK_SIZE) break;
            shadow_stack[shadow_sp] = snode.rightChild;
            shadow_sp++;
            if (shadow_sp >= BVH_STACK_SIZE) break;
            shadow_stack[shadow_sp] = snode.leftChild;
        }
    }
    return false; // 无遮挡
}

void main() {
    // 像素坐标
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    int width = int(pc.viewport_size.x);
    int height = int(pc.viewport_size.y);

    // 超出视口范围的像素不处理
    if (pixel_coords.x >= width || pixel_coords.y >= height) {
        return;
    }

    // === 计算camera ray ===
    vec2 uv = vec2(
        (float(pixel_coords.x) + 0.5) / float(width) * 2.0 - 1.0,
        -((float(pixel_coords.y) + 0.5) / float(height) * 2.0 - 1.0)
    );

    float aspect = float(width) / float(height);
    float tanHalfFov = tan(pc.fov / 2.0);

    vec3 forward = vec3(sin(pc.camera_yaw) * cos(pc.camera_pitch),
                        sin(pc.camera_pitch),
                        -cos(pc.camera_yaw) * cos(pc.camera_pitch));
    vec3 right = vec3(cos(pc.camera_yaw), 0.0, sin(pc.camera_yaw));
    vec3 up = cross(right, forward);

    vec3 ray_dir = normalize(forward + right * uv.x * aspect * tanHalfFov + up * uv.y * tanHalfFov);
    vec3 ray_origin = pc.camera_pos;

    // === 路径追踪主循环 ===
    vec3 throughput = vec3(1.0);    // 路径吞吐量，初始为1
    vec3 accumulated = vec3(0.0);   // 累积radiance
    uint seed = pcg_hash(uint(pixel_coords.x) * 1000u + uint(pixel_coords.y) + 1u + uint(pc.frame_index) * 7919u);

    uint emissive_count_uint = uint(pc.emissive_count);

    for (int bounce = 0; bounce < MAX_BOUNCES; bounce++) {
        // 1. BVH trace找到命中点
        PathHit hit = trace_path_ray(ray_origin, ray_dir);

        // 2. 未命中 → 背景光贡献(仅首bounce)
        if (!hit.hit) {
            if (bounce == 0) {
                // 背景: 深蓝渐变
                float t_bg = 0.5 * (ray_dir.y + 1.0);
                accumulated += throughput * mix(vec3(0.05, 0.05, 0.1), vec3(0.2, 0.3, 0.6), t_bg);
            }
            break; // 路径终止
        }

        // 3. 命中emissive表面 → 直接光源贡献
        if (hit.emissive > 1.5) {
            // emissive命中: 首bounce直接看到光源，后续bounce通过NEE已采样光源
            // 避免双重计算: bounce>0时不添加emissive贡献(NEE已覆盖)
            if (bounce == 0) {
                accumulated += throughput * hit.albedo * 8.0;
            }
            break; // 命中光源，路径终止
        }

        // 4. 命中点位置
        vec3 hit_point = ray_origin + ray_dir * hit.distance;

        // 5. 计算直接光(NEE) — 采样emissive三角形
        vec3 L_direct = vec3(0.0);
        if (emissive_count_uint > 0u) {
            for (int s = 0; s < N_LIGHT_SAMPLES; s++) {
                // 随机选一个emissive三角形
                seed = pcg_hash(seed + uint(s) * 7919u + uint(bounce) * 3571u);
                uint tri_idx = uint(random_float(seed) * float(emissive_count_uint));
                tri_idx = min(tri_idx, emissive_count_uint - 1u);

                EmissiveTriangle etri = emissive_buf.emissive_tris[tri_idx];
                vec3 v0 = etri.v0_area.xyz;
                vec3 v1 = etri.v1_pad.xyz;
                vec3 v2 = etri.v2_pad.xyz;
                float tri_area = etri.v0_area.w;
                vec3 tri_normal = etri.normal_pad.xyz;
                vec3 tri_color = etri.color_int.xyz;
                float tri_intensity = etri.color_int.w;

                // 在三角形表面随机采样一点
                seed = pcg_hash(seed);
                vec3 light_point = sample_point_on_triangle(v0, v1, v2, seed);

                // 计算几何因子G
                vec3 to_light = light_point - hit_point;
                float dist = length(to_light);
                vec3 to_light_dir = normalize(to_light);

                float cos_hit = max(dot(hit.normal, to_light_dir), 0.0);
                float cos_light = max(dot(tri_normal, -to_light_dir), 0.0);

                // G = cos(θ_hit) * cos(θ_light) / dist²
                float G = cos_hit * cos_light / (dist * dist + 0.001);

                // PDF_light = 1 / (N_emissive * triangle_area)
                float pdf_light = 1.0 / (float(emissive_count_uint) * tri_area + 0.001);

                // 阴影射线测试
                bool in_shadow = shadow_test(hit_point, hit.normal, light_point, dist);

                if (!in_shadow && G > 0.0) {
                    // L_direct = L_emissive * albedo * G / PDF_light
                    // Lambert BRDF = albedo/π, 但cosine半球采样PDF=cos/π
                    // BRDF/PDF = albedo，所以直接用albedo
                    vec3 L_emissive = tri_color * tri_intensity;
                    L_direct += hit.albedo * L_emissive * G / pdf_light;
                }
            }
            accumulated += throughput * L_direct / float(N_LIGHT_SAMPLES);
        }

        // 6. 发射间接射线(cosine半球采样)
        // Lambert BRDF = albedo/π, PDF_hemi = cos(θ)/π
        // 贡献 = BRDF * L_incoming * cos(θ) / PDF = albedo * L_incoming
        throughput *= hit.albedo;

        // 7. 俄罗斯轮盘赌(bounce >= 2)
        if (bounce >= 2) {
            float P_continue = max(0.2, luminance(throughput));
            seed = pcg_hash(seed);
            float rr_random = random_float(seed);
            if (rr_random > P_continue) {
                break; // 路径终止
            }
            throughput /= P_continue; // 补偿未终止的路径
        }

        // 8. 生成下一bounce射线
        seed = pcg_hash(seed);
        ray_dir = cosine_hemisphere_sample(hit.normal, seed);
        ray_origin = hit_point + hit.normal * EPSILON * 2.0;
    }

    // === 帧累积降噪 ===
    // 读取累积缓冲区之前的值
    vec4 prev = imageLoad(accumulation_image, pixel_coords);
    vec3 prev_color = prev.rgb;
    int frame = int(pc.frame_index);
    // 蒸汽混合公式: 新的平均值 = (旧均值 * N + 新值) / (N + 1)
    vec3 new_color = (prev_color * frame + accumulated) / (frame + 1);
    imageStore(accumulation_image, pixel_coords, vec4(new_color, 1.0));
    // 输出: tone map + gamma校正
    vec3 mapped = new_color / (new_color + vec3(1.0));
    mapped = pow(mapped, vec3(1.0 / 2.2));
    imageStore(output_image, pixel_coords, vec4(mapped, 1.0));
}