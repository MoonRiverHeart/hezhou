<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Hezhou Editor"
      Manufacturer="Hezhou"
      Version="$(var.Version)"
      UpgradeCode="A6F0C58E-6E4B-4C1A-9C1E-7A0D4B6F2A11"
      Scope="perMachine"
      Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Hezhou Editor is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hezhou" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Hezhou" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Hezhou Editor" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ProgramMenuDir" Guid="6F1B5D5D-64E2-4F5C-A7B9-2D6E7B8F3C21">
      <Shortcut Id="HezhouEditorStartMenu"
                Name="Hezhou Editor"
                Description="Hezhou game editor"
                Target="[INSTALLFOLDER]mono_editor_demo.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Hezhou\Editor" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
